{
  "name": "youtube-notes",
  "version": "0.1.0",
  "description": "Electron app that turns YouTube videos into editable, organized notes.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --dir",
    "fetch-yt-dlp": "node scripts/fetch-yt-dlp.js",
    "copy-katex": "node scripts/copy-katex.js",
    "postinstall": "node scripts/fetch-yt-dlp.js && node scripts/copy-katex.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "katex": "^0.16.45",
    "marked": "^12.0.2",
    "marked-katex-extension": "^5.1.8",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.youtubenotes.app",
    "productName": "YouTube Notes",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
